{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent Sound Switcher",
  "version": "0.1.0",
  "identifier": "com.fluentsoundswitcher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Fluent Sound Switcher",
        "width": 900,
        "height": 640,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/favicon-32x32.png",
      "icons/favicon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}
