{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent Sound Switcher",
  "version": "0.3.3",
  "identifier": "com.fluentsoundswitcher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fluent Sound Switcher",
        "width": 900,
        "height": 640,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": false
      },
      {
        "label": "overlay",
        "url": "index.html",
        "width": 240,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "flyout",
        "url": "index.html",
        "width": 300,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "banner",
        "url": "index.html",
        "width": 340,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Leocadio94/fluent-sound-switcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3MjM5M0FEMzlBNEQ4NjgKUldSbzJLUTVyWk1qMTluYU1UMGkzU2c5bGh3N1lGaEpJTThpamNGZHBrVy84Z21veDJFLzl1RmoK"
    }
  }
}
